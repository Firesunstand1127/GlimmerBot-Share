{
  "$schema": "../../../deps/tools/pipeline.schema.json",
  "PlaneExpeditionDaily": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "PlaneExpeditionDailyPopupFreeDrawClose",
      "PlaneExpeditionDailyPopupFoodPrizeClose",
      "PlanePopupPromoDiamondGift",
      "PlanePopupKoiPromotionClose",
      "PlanePopupFoodPromotionClose",
      "PlaneMapOrOverlayReady",
      "PlaneTrainingEntry",
      "PlaneEnterTrainingFromHome",
      "PlaneNavigateHome"
    ],
    "rate_limit": 100,
    "timeout": 18000,
    "on_error": [
      "PlaneStopSafely"
    ]
  },
  "PlaneEnterTrainingFromHome": {
    "recognition": "And",
    "all_of": [
      "HomeReadyMainCitySelectedFeature",
      "HomeReadyBackpackNavFeature",
      "HomeReadyTrainingNavFeature",
      "HomeReadyCityContentFeature"
    ],
    "action": "Click",
    "target": [
      475,
      1210,
      1,
      1
    ],
    "post_delay": 600,
    "next": [
      "PlaneTrainingEntry",
      "PlaneEnterTrainingFromHome"
    ],
    "max_hit": 3,
    "timeout": 10000,
    "on_error": [
      "PlaneStopSafely"
    ]
  },
  "PlaneNavigateHome": {
    "recognition": "TemplateMatch",
    "template": "trial/home_from_battle.png",
    "threshold": 0.72,
    "roi": [
      0,
      1133,
      133,
      147
    ],
    "action": "Click",
    "target": [
      55,
      1220,
      1,
      1
    ],
    "post_delay": 600,
    "next": [
      "PlaneEnterTrainingFromHome"
    ],
    "max_hit": 3,
    "timeout": 10000,
    "on_error": [
      "PlaneStopSafely"
    ]
  },
  "PlaneTrainingEntry": {
    "recognition": "OCR",
    "roi": [
      450,
      900,
      245,
      150
    ],
    "expected": "^位面征战$",
    "action": "Click",
    "post_delay": 1000,
    "next": [
      "PlaneMapOrOverlayReady"
    ],
    "timeout": 10000,
    "on_error": [
      "PlaneStopSafely"
    ]
  },
  "PlaneReturnHome": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "PlaneReturnCloseResult",
      "PlaneHomeReady",
      "PlaneReturnCloseDifficulty",
      "PlaneReturnCloseCombatPanel",
      "PlaneReturnCloseHirePanel",
      "PlaneReturnCloseFountain",
      "PlaneReturnCloseCross",
      "PlaneReturnFromMap",
      "PlaneReturnFromTraining"
    ],
    "timeout": 10000,
    "on_error": [
      "PlaneStopSafely"
    ]
  },
  "PlaneReturnCloseCombatPanel": {
    "recognition": "OCR",
