{
    "$schema": "../../../deps/tools/pipeline.schema.json",
    "TaskAssistantDaily": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "TaskAssistantWeeklyNotice",
            "TaskAssistantIdleIncomeWarning",
            "TaskAssistantCloseQuizSingleBubble",
            "TaskAssistantCloseQuizPanel",
            "TaskAssistantOpenFromHome",
            "TaskAssistantOpen",
            "TaskAssistantPanelReady",
            "TaskAssistantExecutionFinished",
            "TaskAssistantNavigateHome",
            "TaskAssistantVisibleBack",
            "TaskAssistantRecoverBack"
        ],
        "rate_limit": 100,
        "timeout": 12000,
        "on_error": [
            "TaskAssistantStopSafely"
        ],
        "pre_delay": 0,
        "post_delay": 0
    },
    "TaskAssistantOpenFromHome": {
        "recognition": "And",
